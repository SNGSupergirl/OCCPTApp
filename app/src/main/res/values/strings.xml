    <string name="join_afscme_title">HAVING A GREAT SUPPORT TEAM MAKES ALL THE DIFFERENCE</string>
    <string name="join_afscme_subtitle">Learn more about how being part of Oregon Child Care Providers Together can help you and the families you care for. </string>
    <string name="join_afscme_button_1">REGISTERED FAMILY &amp; CERTIFIED FAMILY LICENSED PROVIDERS\nJOIN OUR UNION</string>
